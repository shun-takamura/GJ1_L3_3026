###############################################################################
# 改行コードの正規化
###############################################################################
* text=auto

###############################################################################
# バイナリとして扱う（改行変換や差分表示をさせない）
#
# text=auto の自動判定でもたいてい正しく扱われるが、
# .lib や .dds が壊れると原因が分かりにくいので明示しておく。
###############################################################################
*.lib   binary
*.pdb   binary
*.dll   binary
*.exe   binary
*.cso   binary
*.dds   binary
*.pack  binary
*.ttf   binary
*.wav   binary
*.mesh  binary
*.skel  binary
*.anim  binary
*.mat   binary
*.zip   binary
*.png   binary
*.jpg   binary

###############################################################################
# mergiraf : 構文を理解した自動マージ
#
# 行単位でしか比較しない素の Git では、二人が同じクラスに別々の関数を
# 追加しただけでもコンフリクトになる。mergiraf は C++ を構文木として
# 解析するため、この種の衝突を自動で解決できる。
#
#   セットアップ: Project/tools/mergiraf/setup_mergiraf.bat をダブルクリック
#                 （クローン後に一度だけ。各自で実行が必要）
#
# 未セットアップの人がいても通常の Git マージに戻るだけで、壊れることはない。
# エンジンのヘッダと外部ライブラリは触らないので対象外にする。
###############################################################################
Project/Game/**/*.cpp merge=mergiraf
Project/Game/**/*.h   merge=mergiraf

###############################################################################
# 排他ロック (git-lfs の lockable)
#
# 新規ソースをプロジェクトに追加すると .vcxproj / .filters の同じ箇所を
# 全員が書き換えるため衝突しやすい。編集前にロックを取ることで、
# 他の人が同じファイルを push できないようにする。
#
#   事前に一度だけ:  git lfs install
#   編集する前に:    git lfs lock   Project/Game/GJ1_L3_3026.vcxproj
#   push した後に:   git lfs unlock Project/Game/GJ1_L3_3026.vcxproj
#   誰が何をロック中か: git lfs locks
#
# ロックしたら push 後に必ず解除する（放置すると他の人が作業できない）。
# 注意: git-lfs を入れていると lockable なファイルは読み取り専用になる。
#       編集できないときは lock を取ること。
###############################################################################
Project/Game/GJ1_L3_3026.vcxproj         lockable
Project/Game/GJ1_L3_3026.vcxproj.filters lockable
