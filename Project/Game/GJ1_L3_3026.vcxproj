  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <!--
    実行に必要な DLL を出力フォルダへ置く。

    バッチの copy ではなく MSBuild の Copy タスクを使うのは、展開先のパスに
    日本語が含まれていても確実に動かすため（PostBuildEvent は一時バッチ経由なので
    コードページの影響を受ける）。

    dxcompiler.dll / dxil.dll は Windows SDK に入っているが、
    SDK のバージョンによっては dxil.dll が同梱されていないことがある。
    そのため $(TargetPlatformVersion) だけを見ず、見つかったものを使う。
  -->
  <Target Name="CopyRuntimeDlls" AfterTargets="Build">
    <ItemGroup>
      <!-- SDK のどのバージョンに入っていても拾えるようワイルドカードで探す -->
      <SdkDxc Include="$(WindowsSdkDir)bin\*\x64\dxcompiler.dll" />
      <SdkDxil Include="$(WindowsSdkDir)bin\*\x64\dxil.dll" />
      <RuntimeDll Include="$(SolutionDir)externals\DirectStorage\bin\x64\dstorage.dll" />
      <RuntimeDll Include="$(SolutionDir)externals\DirectStorage\bin\x64\dstoragecore.dll" />
    </ItemGroup>

    <!-- 複数バージョンが見つかった場合は最後（＝最も新しい）のものを使う -->
    <PropertyGroup>
      <_DxcPath>%(SdkDxc.FullPath)</_DxcPath>
      <_DxilPath>%(SdkDxil.FullPath)</_DxilPath>
    </PropertyGroup>

    <Copy SourceFiles="@(RuntimeDll)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(_DxcPath)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true"
          Condition="'$(_DxcPath)' != '' And Exists('$(_DxcPath)')" />
    <Copy SourceFiles="$(_DxilPath)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true"
          Condition="'$(_DxilPath)' != '' And Exists('$(_DxilPath)')" />

    <Warning Text="dxcompiler.dll が Windows SDK に見つかりませんでした。シェーダの実行時コンパイルができません。"
             Condition="'$(_DxcPath)' == ''" />
    <Warning Text="dxil.dll が Windows SDK に見つかりませんでした。別バージョンの SDK を入れるか、手動で配置してください。"
             Condition="'$(_DxilPath)' == ''" />
  </Target>
  <ImportGroup Label="ExtensionTargets" />
  <!--
    アセットコンバータ。Assets/ に置いた元データを Resources/ へ変換する。
    gdeflate_compress.exe は配布物の bin/ に同梱されている。
  -->
  <PropertyGroup>
    <BuildDependsOn>CookAssets;$(BuildDependsOn)</BuildDependsOn>
  </PropertyGroup>
  <Target Name="CookAssets">
    <Message Importance="high" Text="Cooking assets..." />
    <!-- 日本語を含むパスでもバッチが文字化けしないようコードページを UTF-8 に固定する -->
    <Copy SourceFiles="$(SolutionDir)externals\DirectStorage\bin\x64\dstorage.dll;$(SolutionDir)externals\DirectStorage\bin\x64\dstoragecore.dll"
          DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Exec Command="chcp 65001 &gt;nul &amp;&amp; py tools\Python\convert_hdr_to_dds.py --silent" WorkingDirectory="$(SolutionDir)" />
    <Exec Command="chcp 65001 &gt;nul &amp;&amp; py tools\Python\cook_assets.py" WorkingDirectory="$(SolutionDir)" />
    <Exec Command="chcp 65001 &gt;nul &amp;&amp; py tools\Python\pack_assets.py --gdeflate-exe bin\gdeflate_compress.exe" WorkingDirectory="$(SolutionDir)" />
  </Target>
